<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/architecture/release.md#manifest-allowlist owns an *allowlist* of what
  may be declared. Permissions arrive in the slice that uses them, and CI fails
  on anything outside the allowlist (manifestPermissionAllowlist).

  S02 (Issue #73) declares exactly the four install-time permissions local
  discovery uses (docs/architecture/discovery.md#permission-gate). They are
  normal permissions: at targetSdk 36 none of them shows a runtime prompt, so
  the in-app explanation's Continue grants the permission gate. :samsung
  declares the same four in its own manifest, next to the code that needs them.

  Explicitly absent and not to be added here: AD_ID, any location permission,
  ACCESS_LOCAL_NETWORK (not while targetSdk is 36), NEARBY_WIFI_DEVICES (the
  V1 probes do not require it), boot receivers, foreground-service
  permissions, and install-package permissions.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".AppTApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppT">

        <!-- One activity (docs/architecture/presentation.md#route-graph). -->
        <!-- No android:label here: it would duplicate the application label. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
