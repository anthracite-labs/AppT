<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/appt_surface" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Themed-icon support: Android 13+ tints this layer to the user's wallpaper
      palette. The monochrome layer must be a flat silhouette, so it reuses the
      foreground path without the brand colour.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
