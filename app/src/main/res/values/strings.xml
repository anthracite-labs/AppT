    <string name="welcome_value_proposition">Your TV remote, on your phone</string>
    <string name="welcome_privacy_reassurance">AppT controls your television directly over your home network. Your televisions and your settings stay on this phone.</string>
    <string name="welcome_primary_action">Find my TV</string>
