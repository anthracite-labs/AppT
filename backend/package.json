{
  "name": "appt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AppT Entitlement Backend — standalone TypeScript package for the future Cloud Functions 2nd gen service. S01 is a non-deploying skeleton.",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "type": "commonjs",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "knip": "knip",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "clean": "rimraf lib",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "knip": "6.36.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1"
  }
}
